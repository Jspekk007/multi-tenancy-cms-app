{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "sourceMap": false,
    "declarationMap": false,
    "paths": {
      "@backend/utils/*": ["./src/utils/*"],
      "@backend/modules/*": ["./src/modules/*"],
      "@backend/services/*": ["./src/services/*"],
      "@backend/types/*": ["./src/types/*"],
      "@backend/middlewares/*": ["./src/middlewares/*"],
      "@backend/db/*": ["./src/db/*"],
      "@backend/lib/*": ["./lib/*"],
      "@backend/queues/*": ["./queues/*"],
      "@backend/trpc": ["./src/trpc.ts"],
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}