{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "es2022",
    "sourceMap": false,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "paths": {
      "@backend/utils/*": ["./src/utils/*"],
      "@backend/modules/*": ["./src/modules/*"],
      "@backend/services/*": ["./src/services/*"],
      "@backend/types/*": ["./src/types/*"],
      "@backend/middlewares/*": ["./src/middlewares/*"],
      "@backend/db/*": ["./src/db/*"],
      "@backend/lib/*": ["./src/lib/*"],
      "@backend/queues/*": ["./src/queues/*"],
      "@backend/trpc": ["./src/trpc.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}