{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "yarn prisma:generate && tsx --watch src/index.ts",
    "prisma:generate": "prisma generate --no-hints --schema ./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ./prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema ./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema ./prisma/schema.prisma",
    "prisma:db-push": "prisma db push --schema ./prisma/schema.prisma",
    "build": "yarn prisma:generate && tsc -p tsconfig.json",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "worker:dev": "tsx watch src/worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "@supabase/supabase-js": "^2.108.2",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "handlebars": "^4.7.9",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.9.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.1",
    "pino": "^9.11.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.1",
    "superjson": "^2.2.6",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.4",
    "dotenv-cli": "^10.0.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
