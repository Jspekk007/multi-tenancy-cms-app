{
  "name": "multi-tenant-cms",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "backend:dev": "yarn workspace backend dev",
    "backend:build": "yarn workspace backend build",
    "backend:lint": "yarn workspace backend lint",
    "backend:lint:fix": "yarn workspace backend lint:fix",
    "backend:typecheck": "yarn backend:build",
    "backend:test": "yarn workspace backend test",
    "frontend:dev": "yarn workspace frontend dev",
    "frontend:build": "yarn workspace frontend build",
    "frontend:lint": "yarn workspace frontend lint",
    "frontend:typecheck": "yarn workspace frontend typecheck",
    "frontend:test": "yarn workspace frontend test",
    "redis:dev": "docker-compose up redis",
    "dev:worker": "yarn workspace backend worker:dev",
    "dev": "concurrently \"yarn backend:dev\" \"yarn frontend:dev\" \"yarn redis:dev\" \"yarn dev:worker\"",
    "build": "yarn backend:build && yarn frontend:build",
    "typecheck": "yarn backend:typecheck && yarn frontend:typecheck",
    "validate": "yarn lint && yarn typecheck",
    "test": "yarn backend:test && yarn frontend:test",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.4",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "semantic-release": "^24.2.7",
    "typescript": "5.9.2"
  },
  "resolutions": {
    "dompurify": "3.2.7",
    "@trpc/server": "11.18.0",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "effect": "3.21.0",
    "postcss": "8.5.14",
    "qs": "6.15.2",
    "shell-quote": "1.8.4",
    "ws": "8.21.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "nohoist": [
    "**/@storybook/**",
    "**/@storybook/**/**"
  ],
  "dependencies": {}
}
