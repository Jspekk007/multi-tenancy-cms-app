{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "yarn --cwd ../backend prisma:generate --no-hints && next build",
    "start": "next start",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
